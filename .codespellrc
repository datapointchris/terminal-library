# Carried over from dotfiles' ignore-words-list when the cards moved out. Only
# the words these files actually need, not the whole inherited list.
#
#   te — `<leader>te` is a Neovim tab binding, not a misspelling of "the".
#   enew — `:enew` opens an empty buffer in the current window, not "new".
#   ot — `:ot` is broot's shortcut for open_trash, not a misspelling of "to".
[codespell]
ignore-words-list = te,enew,ot
